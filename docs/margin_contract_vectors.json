  },
  "fieldSemantics": {
    "input.paper": "源纸空间（旋转前）的目标纸尺寸。D1 冻结：margin 定义于此空间。",
    "input.source.pageRotate": "源 PDF 页自带的 /Rotate 属性（0/90/180/270），由 §1.4 归一。",
    "input.source.widthPt/heightPt": "§1.4 归一后的有效可视尺寸（已应用 pageRotate 的转置）。",
    "input.spec.contentRotation": "Policy A 业务内容旋转 theta。与 pageRotate 是两个独立概念，禁止合并。",
    "input.spec.allowUpscale": "INV-3 的显式开关，默认 false。",
    "expected.mediaBox": "输出物理纸尺寸。theta%180==90 时按 Policy A 交换宽高（见 ERRATA-2）。",
    "expected.contentBox": "放置后内容外接矩形，规范空间（原点左下）。",
    "expected.effectiveMargins": "输出空间四边留白，冗余字段，便于人工核对与 raster gate 直接比对。"
  },
  "errata": [
    {
      "id": "ERRATA-1",
      "severity": "blocker-for-V-08",
      "target": "print_margin_contract.md §1.1",
      "issue": "§1.1 公式为 scale = min(uW/cW, uH/cH)，无 clamp；INV-3 却规定默认禁止 scale>1。两者冲突，源页小于 usableRect 时行为未定义。",
      "proposal": "§1.1 改为 scale = allowUpscale ? min(sx, sy) : min(1, sx, sy)，并在 INV-3 注明默认 allowUpscale=false。",
      "status": "applied",
      "resolution": "用户签署并收紧措辞（contract v1.1 §1.1 + INV-3）：clamp 只是 scale 上限，不是另一套布局规则；仅当 sx>1 且 sy>1 时生效，任一方向超界仍照常缩小。契约中加入两行反例（300x300/usable500 保持原尺寸；300x600/usable500 仍缩到 0.8333），防止实现者读成「小图永远不 fit」或另开分支。"
    },
    {
      "id": "ERRATA-2",
      "severity": "blocker-for-V-04",
      "target": "print_margin_contract.md §1.2 INV-1",
      "issue": "INV-1 写 effectivePageSize(output) == targetPaper。若 targetPaper 指源纸空间的纸，则 Policy A 下 rot90 输出必然违反 INV-1（宽高已交换）。",
      "proposal": "INV-1 补一句：targetPaper 指经 Policy A 变换后的输出纸，即 theta%180==90 时为 swap(paper)。",
      "status": "applied",
      "resolution": "用户签署但【否决】把 swap 规则直接写进 INV-1，理由是会造成 INV-1 <-> Policy A 循环定义。最终落地为分层：INV-1 只陈述『输出 MediaBox == 经 Paper Orientation 与 Rotation Policy 解析后的最终物理输出纸张尺寸（容差 0.1pt）』；swap 规则单独成节 contract v1.1 §2.1a『Policy A 定义』，且 Policy A 不得反向引用 INV-1。单向依赖。"
    },
    {
      "id": "ERRATA-3",
      "severity": "editorial",
      "target": "print_margin_contract.md §7.2 向量 id 表",
      "issue": "表中列 V-01..V-07 共 7 条，本文件为 9 条（新增 V-05b 与 V-08）。",
      "proposal": "§7.2 表补入 V-05b-zero-margin-crossfit 与 V-08-no-upscale。",
      "status": "applied",
      "resolution": "已补入 contract v1.1 §7.2。V-05b 的表述按用户意见改为强调其真实职责：抓的不是 margin 几何，而是『zero margin != bypass contract』这条极易被后续性能优化破坏的边界。"
    },
    {
      "id": "ERRATA-4",
      "severity": "high",
      "target": "Gate 1 提案 schema",
      "issue": "提案 schema 用单一 source.rotation 字段，会把「源页 /Rotate 属性」与「Policy A 内容旋转 theta」混为一谈。二者在 §1.4 与 §2.1 是不同概念，混用会让 V-04 与 V-07 无法区分。",
      "proposal": "已在本文件拆为 input.source.pageRotate 与 input.spec.contentRotation。",
      "status": "applied"
    },
    {
